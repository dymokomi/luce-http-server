from http import Server, ServerConfig, StaticRoot
import application
import settings

pub func main(arguments: list[str]) -> int!:
    let config = settings.parse(arguments)
    let options = ServerConfig(address = config.address, port = config.port,
        network_workers = config.network_workers, application_workers = config.application_workers,
        temporary_directory = config.upload_directory)
    let server = Server(options, application.configure, config.upload_directory)
    server.mount("/", StaticRoot(config.public_directory))
    server.shutdown_on_signals()
    server.start()
    print(f"READY {server.port()}")
    server.run()
    server.close()
    print("STOPPED")
    return 0
