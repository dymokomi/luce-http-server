from http import Server, ServerConfig, StaticRoot
import application
import settings

pub func main(arguments: list[str]) -> int!:
    let config = try settings.parse(arguments)
    let options = ServerConfig(address = config.address, port = config.port,
        network_workers = config.network_workers, application_workers = config.application_workers,
        temporary_directory = config.upload_directory)
    let server = try Server(options, application.configure, config.upload_directory)
    try server.mount("/", try StaticRoot(config.public_directory))
    try server.shutdown_on_signals()
    try server.start()
    print(f"READY {try server.port()}")
    try server.run()
    server.close()
    print("STOPPED")
    return 0
