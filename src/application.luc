## Each worker constructs its own handlers. The server owns thread startup,
## dispatch and shutdown; this factory declares only application behavior.
from http import Router, Application
from api import Api

pub func configure(upload_directory: str) -> Application!:
    let api = Api(upload_directory)
    let router = try Router()
    try router.get("/api/health", api.health)
    try router.get("/api/items/{id}", api.item)
    try router.get("/api/greet", api.greet)
    try router.post("/api/echo", api.echo)
    try router.put("/api/files/{name}", api.upload)
    try router.get("/api/files/{name}", api.download)
    try router.websocket("/ws/echo", api.websocket_echo)
    return try router.application()
